# Suraksha Diagnostic - environment template
# Copy to .env and adjust values for your environment.

# Flask session/cookie signing key. CHANGE THIS IN PRODUCTION.
SECRET_KEY=change-me-to-a-long-random-string

# Database. Defaults to local SQLite file (./suraksha.db).
# For cloud/managed databases later, set e.g. (psycopg v3 ships in
# requirements.txt):
#   DATABASE_URL=postgresql://user:pass@host:5432/suraksha
#   DATABASE_URL=mysql+pymysql://user:pass@host:3306/suraksha
# On Vercel the Neon Marketplace integration injects DATABASE_URL for you;
# without it SQLite lives in /tmp and is re-seeded on cold start.
DATABASE_URL=sqlite:///suraksha.db

# Set to 1 when serving over HTTPS so the session cookie is Secure.
# Defaults to 1 automatically when running on Vercel.
SESSION_COOKIE_SECURE=0

# Comma separated list of allowed origins for the API (only needed if the
# frontend is served from a different host than the API).
CORS_ORIGINS=

# Default timezone used for date maths (IANA name).
TIMEZONE=Asia/Kolkata
